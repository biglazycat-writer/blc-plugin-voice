{
  "name": "blc-plugin-voice",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "大懒猫写作本地语音插件：本地引擎朗读文章、多音色切换、文章一键转播客",
  "engines": {
    "node": ">=22.23.3 <23.0.0",
    "biglazycat": ">=0.4.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "tsc -p tsconfig.node.json && vite build",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "blc-plugin-sdk": "file:vendor/blc-plugin-sdk-1.7.0.tgz",
    "tar-stream": "3.2.2",
    "unbzip2-stream": "1.4.3"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "2.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "files": [
    "dist",
    "package-lock.json",
    "README.md",
    "README.en.md",
    "vendor/blc-plugin-sdk-1.7.0.tgz"
  ],
  "biglazycat": {
    "apiVersion": 1,
    "minimumApiRevision": 7,
    "displayName": "语音工坊 · 本地朗读与播客",
    "description": "用本机 TTS 引擎离线朗读文章：Windows 系统音色开箱即用，可下载本地神经网络模型扩展音色；支持多音色收藏、语速语调调整，并把文章生成单人/双人对谈播客导出 WAV/MP3。",
    "main": "dist/main.js",
    "mainView": "main",
    "platforms": [
      "windows/amd64",
      "windows/arm64",
      "darwin/amd64",
      "darwin/arm64",
      "linux/amd64",
      "linux/arm64"
    ],
    "contributes": {
      "commands": [
        {
          "id": "voice.open",
          "title": "制作播客",
          "description": "选择文章，配置音色并制作播客。",
          "aiCallable": true,
          "externalEffect": false
        },
        {
          "id": "voice.status",
          "title": "查看语音工坊状态",
          "description": "返回引擎可用性、已装模型、任务与磁盘占用概览。",
          "aiCallable": true,
          "externalEffect": false
        },
        {
          "id": "voice.engines.list",
          "title": "列出本地语音引擎",
          "description": "返回全部引擎及其可用性与不可用原因。",
          "aiCallable": false,
          "externalEffect": false
        },
        {
          "id": "voice.voices.list",
          "title": "列出可用音色",
          "description": "合并全部引擎音色目录，附带收藏与参数配置。",
          "aiCallable": true,
          "externalEffect": false
        },
        {
          "id": "voice.settings.get",
          "title": "读取语音工坊设置",
          "description": "返回默认音色、收藏、参数、镜像等设置。",
          "aiCallable": false,
          "externalEffect": false
        },
        {
          "id": "voice.settings.update",
          "title": "更新语音工坊设置",
          "description": "合并写入设置补丁（默认音色、收藏、参数、镜像）。",
          "aiCallable": false,
          "externalEffect": false
        },
        {
          "id": "voice.voices.test",
          "title": "试听音色",
          "description": "用指定音色合成试听句子，返回可播放的音频 ID。",
          "aiCallable": false,
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "voiceId": {
                "type": "string",
                "description": "音色 ID"
              },
              "text": {
                "type": "string",
                "description": "自定义试听文本，缺省用内置例句"
              }
            },
            "required": [
              "voiceId"
            ]
          }
        },
        {
          "id": "voice.job.create",
          "title": "创建朗读任务",
          "description": "把当前文档或粘贴文本切分为朗读段落。",
          "aiCallable": false,
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "document",
                  "text"
                ],
                "description": "document 用调用上下文里的当前文档，text 用传入文本"
              },
              "text": {
                "type": "string",
                "description": "source 为 text 时的正文"
              },
              "title": {
                "type": "string",
                "description": "任务标题，缺省取文档标题或首行"
              }
            },
            "required": [
              "source"
            ]
          }
        },
        {
          "id": "voice.render",
          "title": "朗读全文",
          "description": "按音色与语速把朗读任务逐段合成为音频，进度可取消。",
          "aiCallable": true,
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "description": "voice.job.create 返回的任务 ID"
              },
              "voiceId": {
                "type": "string",
                "description": "朗读音色 ID"
              },
              "speed": {
                "type": "number",
                "description": "语速 0.5–2.0，缺省 1"
              }
            },
            "required": [
              "jobId",
              "voiceId"
            ]
          }
        },
        {
          "id": "voice.audio.info",
          "title": "查看音频清单",
          "description": "返回一次合成产物的分段清单（文本、时长、字节数）。",
          "aiCallable": false,
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "audioId": {
                "type": "string",
                "description": "音频产物 ID"
              }
            },
            "required": [
              "audioId"
            ]
          }
        },
        {
          "id": "voice.audio.read",
          "title": "分块读取音频",
          "description": "按偏移分块读取某段音频的 base64 内容，单块远小于 1 MiB。",
          "aiCallable": false,
          "visibility": "internal",
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "audioId": {
                "type": "string",
                "description": "音频产物 ID"
              },
              "index": {
                "type": "integer",
                "description": "分段序号；省略表示导出的整段音频"
              },
              "offset": {
                "type": "integer",
                "description": "文件内字节偏移"
              },
              "hash": {
                "type": "string",
                "description": "上次返回的整文件哈希，用于变更校验"
              }
            },
            "required": [
              "audioId"
            ]
          }
        },
        {
          "id": "voice.export",
          "title": "导出音频文件",
          "description": "把朗读或播客合成结果合并导出为 WAV/MP3，弹出行内保存对话框。",
          "aiCallable": false,
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "audioId": {
                "type": "string",
                "description": "音频产物 ID"
              },
              "format": {
                "type": "string",
                "enum": [
                  "wav",
                  "mp3"
                ],
                "description": "导出格式"
              }
            },
            "required": [
              "audioId",
              "format"
            ]
          }
        },
        {
          "id": "voice.models.list",
          "title": "查看本地语音模型",
          "description": "返回内置模型目录、安装状态与下载镜像设置。",
          "aiCallable": true,
          "externalEffect": false
        },
        {
          "id": "voice.models.download",
          "title": "下载语音模型",
          "description": "下载并解压本地神经网络语音模型到插件数据目录，进度可取消。",
          "aiCallable": true,
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "modelId": {
                "type": "string",
                "description": "模型目录中的模型 ID"
              }
            },
            "required": [
              "modelId"
            ]
          }
        },
        {
          "id": "voice.models.remove",
          "title": "删除语音模型",
          "description": "删除已安装的本地语音模型，释放磁盘空间。",
          "aiCallable": false,
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "modelId": {
                "type": "string",
                "description": "已安装模型的 ID"
              }
            },
            "required": [
              "modelId"
            ]
          }
        },
        {
          "id": "voice.podcast.script",
          "title": "生成播客脚本",
          "description": "调用平台 AI 改写成单人独白或双人对谈脚本，也可选择本地规则。",
          "aiCallable": true,
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "document",
                  "text",
                  "article"
                ],
                "description": "document 用调用上下文里的当前文档，text 用传入文本"
              },
              "text": {
                "type": "string",
                "description": "source 为 text 时的正文"
              },
              "title": {
                "type": "string",
                "description": "节目主题，缺省取文章标题"
              },
              "style": {
                "type": "string",
                "enum": [
                  "solo",
                  "duet"
                ],
                "description": "solo 单人独白，duet 双人对谈"
              },
              "minutes": {
                "type": "number",
                "description": "目标时长（分钟），缺省 5"
              },
              "useAi": {
                "type": "boolean",
                "description": "是否调用宿主 AI，缺省 true"
              },
              "path": {
                "type": "string"
              },
              "modelId": {
                "type": "string",
                "description": "平台文本模型 ID，留空使用平台默认模型"
              }
            },
            "required": [
              "source",
              "style"
            ]
          }
        },
        {
          "id": "voice.podcast.script.read",
          "title": "读取播客脚本",
          "description": "按脚本 ID 返回已生成的播客脚本内容。",
          "aiCallable": false,
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "scriptId": {
                "type": "string",
                "description": "脚本 ID"
              }
            },
            "required": [
              "scriptId"
            ]
          }
        },
        {
          "id": "voice.podcast.script.update",
          "title": "保存播客脚本修改",
          "description": "把用户编辑后的脚本行写回脚本文件。",
          "aiCallable": false,
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "scriptId": {
                "type": "string",
                "description": "脚本 ID"
              },
              "lines": {
                "type": "array",
                "description": "编辑后的台词行",
                "items": {
                  "type": "object",
                  "properties": {
                    "speaker": {
                      "type": "string",
                      "enum": [
                        "host",
                        "guest"
                      ],
                      "description": "说话人"
                    },
                    "text": {
                      "type": "string",
                      "description": "台词"
                    }
                  },
                  "required": [
                    "speaker",
                    "text"
                  ]
                }
              }
            },
            "required": [
              "scriptId",
              "lines"
            ]
          }
        },
        {
          "id": "voice.podcast.render",
          "title": "合成播客音频",
          "description": "按说话人音色逐行合成播客并拼接停顿，进度可取消。",
          "aiCallable": true,
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "scriptId": {
                "type": "string",
                "description": "脚本 ID"
              },
              "hostVoiceId": {
                "type": "string",
                "description": "主持人音色，缺省用设置"
              },
              "guestVoiceId": {
                "type": "string",
                "description": "嘉宾音色，缺省用设置"
              },
              "speed": {
                "type": "number",
                "description": "语速 0.5–2.0，缺省 1"
              }
            },
            "required": [
              "scriptId"
            ]
          }
        },
        {
          "id": "voice.articles.list",
          "title": "选择播客文章",
          "visibility": "internal",
          "aiCallable": false,
          "externalEffect": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              }
            }
          }
        }
      ],
      "views": [
        {
          "id": "main",
          "title": "播客制作",
          "entry": "dist/ui/index.html",
          "defaultLocation": "tab",
          "route": "/main"
        },
        {
          "id": "settings",
          "title": "语音设置",
          "entry": "dist/ui/index.html",
          "defaultLocation": "tab",
          "route": "/settings",
          "commandPalette": false
        }
      ],
      "services": [
        {
          "id": "tts",
          "version": "1.0.0",
          "methods": [
            "voices",
            "synthesize"
          ]
        },
        {
          "id": "speech-provider",
          "version": "1.0.0",
          "methods": [
            "voices",
            "synthesize",
            "read",
            "release"
          ]
        }
      ],
      "providers": [
        {
          "id": "speech.tts",
          "contract": "speech.tts",
          "version": 1,
          "service": "speech-provider"
        }
      ],
      "features": [
        {
          "id": "play",
          "title": "文章播放",
          "actions": {
            "toolbar": {
              "speech": "speech.tts"
            },
            "editor": {
              "speech": "speech.tts"
            }
          },
          "defaults": [
            "toolbar"
          ]
        },
        {
          "id": "podcast",
          "title": "播客制作",
          "actions": {
            "toolbar": {
              "command": "voice.open"
            },
            "editor": {
              "command": "voice.open"
            }
          },
          "defaults": [
            "editor",
            "toolbar"
          ]
        }
      ]
    },
    "settingsView": "settings"
  }
}
